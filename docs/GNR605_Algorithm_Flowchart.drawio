        <mxCell id="p0_idw" value="&lt;b&gt;A5 · IDW fill (optional)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;Unmonitored cells get ẑ = Σ wᵢ zᵢ / Σ wᵢ with wᵢ = 1 / dᵢ². Labeled statistical_estimate&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffedd5;strokeColor=#c2410c;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="90.0" y="1035" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p0_refuse" value="&lt;b&gt;No pollution surface&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;Unmonitored cells stay null. /hotspots returns refused (the run is still logged)&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#fee2e2;strokeColor=#b91c1c;dashed=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">

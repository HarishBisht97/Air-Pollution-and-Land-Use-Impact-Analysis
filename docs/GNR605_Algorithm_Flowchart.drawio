        <mxCell id="p0_start" value="&lt;b&gt;Start&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#e7e5e4&quot; style=&quot;font-size: 11px;&quot;&gt;How are land use and air quality associated across NCT of Delhi?&lt;/font&gt;" style="rounded=1;arcSize=50;fillColor=#3f6212;strokeColor=#365314;fontColor=#ffffff;fontSize=13;strokeWidth=1.5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="550.0" y="100" width="420" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p0_cfg" value="&lt;b&gt;Read the city definition (config/cities/delhi.yaml)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;Store in EPSG:4326 · measure in UTM 43N (EPSG:32643) · grid 1000 m · buffers 100 / 300 / 500 / 1000 m&lt;br&gt;Pollutants PM2.5, PM10, NO2, SO2, CO, O3 · hotspot_min_stations = 8&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;fillColor=#e0f2fe;strokeColor=#0369a1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="440.0" y="196" width="640" height="84" as="geometry" />
        </mxCell>
        <mxCell id="p0_seed" value="&lt;b&gt;A1 · Seed the study area (idempotent, on API start)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;City boundary → 1 km analysis grid (A4) → OSM-like roads, parks, industry, water → SAMPLE rasters → dataset catalogue&lt;/font&gt;" style="shape=process;backgroundOutline=1;size=0.035;fillColor=#ecfccb;strokeColor=#3f6212;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="440.0" y="316" width="640" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p0_d_real" value="XKDR PM2.5 and station files present in data/raw?" style="rhombus;fillColor=#f4f1ea;strokeColor=#3f6212;strokeWidth=1.5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="600.0" y="432" width="320" height="130" as="geometry" />

        <mxCell id="p6_d_5" value="≥ 5 comparable years?&lt;br&gt;(concentration index, 2018–2024, not partial)" style="rhombus;fillColor=#f4f1ea;strokeColor=#3f6212;strokeWidth=1.5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="990.0" y="850" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p6_ins2" value="&lt;b&gt;AQI line withheld&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;The built-area line is still returned&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#fafaf9;strokeColor=#78716c;dashed=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1460.0" y="890" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p6_afit" value="&lt;b&gt;AQI-on-built line&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;OLS mean_AQI = c + d·built_km² over the comparable years&lt;br&gt;Evaluate at the projected low, central and high built area; interval = [min lower CI, max upper CI]&lt;br&gt;Flag when the central built area is outside the observed range&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffedd5;strokeColor=#c2410c;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">

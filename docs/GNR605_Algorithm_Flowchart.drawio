        <mxCell id="p0_d_n" value="At least 8 monitored cells?" style="rhombus;fillColor=#f4f1ea;strokeColor=#3f6212;strokeWidth=1.5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="600.0" y="1010" width="320" height="130" as="geometry" />

        <mxCell id="p4_title" value="&lt;b&gt;A4–A5 · Analysis grid, cell metrics, station-in-cell and IDW gate&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;fontSize=22;" vertex="1" parent="1">

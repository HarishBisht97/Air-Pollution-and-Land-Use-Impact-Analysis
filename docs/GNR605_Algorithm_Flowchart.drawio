        <mxCell id="p7_start" value="&lt;b&gt;Start · A9&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#e7e5e4&quot; style=&quot;font-size: 11px;&quot;&gt;Monitors, 2024 XKDR monthly files, Dynamic World 2024, OSM, classes, wards&lt;/font&gt;" style="rounded=1;arcSize=50;fillColor=#3f6212;strokeColor=#365314;fontColor=#ffffff;fontSize=13;strokeWidth=1.5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="670.0" y="100" width="420" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p7_means" value="&lt;b&gt;2024 monitor means for PM2.5, NO2 and ozone&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;A month counts when it has ≥ 336 hours; a monitor needs ≥ 6 such months&lt;br&gt;mean = Σ mean_m · n_m / Σ n_m (hour-weighted)&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f7fee7;strokeColor=#3f6212;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="560.0" y="200" width="640" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p7_dw" value="&lt;b&gt;Dynamic World 2024, same 1 km square&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;built % = class 6 · vegetation % = classes 1, 2, 5 (trees, grass, shrub)&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f7fee7;strokeColor=#3f6212;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="560.0" y="330" width="640" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p7_d_osm" value="OSM Overpass extract readable?" style="rhombus;fillColor=#f4f1ea;strokeColor=#3f6212;strokeWidth=1.5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="720.0" y="440" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p7_osmmiss" value="&lt;b&gt;Parks, roads, industry → missing_data&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;The missing file path is reported&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#fee2e2;strokeColor=#b91c1c;dashed=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1260.0" y="465" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p7_split" value="&lt;b&gt;Split OSM elements into layers&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;highway ∈ {motorway, trunk, primary} → major roads · landuse = industrial → industry&lt;br&gt;leisure ∈ {park, garden} or landuse = grass → parks · relations: outer − inner rings; invalid shapes repaired&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#44403c;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="560.0" y="600" width="640" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p7_proj" value="&lt;b&gt;Union each layer and project to EPSG:32643&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#44403c;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="560.0" y="730" width="640" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p7_metrics" value="&lt;b&gt;Per-monitor metrics (metres, UTM)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;industrial share = 100 × area(1 km square ∩ industry) / area(square) · distance to industry&lt;br&gt;distance to the nearest major road · road length within 300 m · park area within 500 m · distance to a park&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f7fee7;strokeColor=#3f6212;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="560.0" y="810" width="640" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p7_tercile" value="&lt;b&gt;Tercile contrast (used throughout)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;Sort monitors by the land measure; t = ⌊n / 3⌋; need t ≥ 3&lt;br&gt;low = first t monitors, high = last t monitors&lt;br&gt;% difference = 100 × (mean_high − mean_low) / mean_low&lt;/font&gt;" style="shape=note;size=14;fillColor=#fefce8;strokeColor=#a16207;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">

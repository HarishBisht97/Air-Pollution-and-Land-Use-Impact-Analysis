        <mxCell id="p2_d_req" value="Required columns present?&lt;br&gt;(station_id, pollutant, concentration, observed_at)" style="rhombus;fillColor=#f4f1ea;strokeColor=#3f6212;strokeWidth=1.5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="324" width="360" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p2_err" value="&lt;b&gt;Stop with an error&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;ValueError: CSV missing required columns&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#fee2e2;strokeColor=#b91c1c;dashed=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="900.0" y="359" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2_batch" value="&lt;b&gt;Open an IngestionBatch (status = running)&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#44403c;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="340.0" y="494" width="520" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p2_d_more" value="Another row?" style="rhombus;fillColor=#f4f1ea;strokeColor=#3f6212;strokeWidth=1.5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="450.0" y="580" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2_fin" value="&lt;b&gt;Close the batch&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;Write processed, inserted, skipped, rejected; status = completed; commit&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#44403c;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="880.0" y="600" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2_end" value="&lt;b&gt;End · return the ingestion report&lt;/b&gt;" style="rounded=1;arcSize=50;fillColor=#3f6212;strokeColor=#365314;fontColor=#ffffff;fontSize=13;strokeWidth=1.5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="880.0" y="710" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2_norm" value="&lt;b&gt;processed += 1 · normalise the pollutant name&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;pm25, pm_2_5 → PM2.5 · ozone → O3 · unknown name → row rejected&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#44403c;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="340.0" y="730" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2_d_blank" value="Concentration cell blank?" style="rhombus;fillColor=#f4f1ea;strokeColor=#3f6212;strokeWidth=1.5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="450.0" y="840" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2_skip1" value="&lt;b&gt;skipped += 1&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#44403c;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="70.0" y="865" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2_note" value="&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;Any exception inside a row (bad number, unknown pollutant or unit) is caught: rejected += 1 with the message and the loop continues. At most 50 error messages are returned.&lt;/font&gt;" style="shape=note;size=14;fillColor=#fefce8;strokeColor=#a16207;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="870.0" y="830" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2_conv" value="&lt;b&gt;Convert to the canonical unit&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;PM2.5, PM10, NO2, SO2, O3 → µg/m³ · CO → mg/m³ (CO with no unit column is read as mg/m³)&lt;br&gt;Gas in ppm or ppb: µg/m³ = ppm × MW × 1000 / 24.45 (25 °C, 1 atm) · PM in ppm/ppb → rejected&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f7fee7;strokeColor=#3f6212;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="320.0" y="990" width="560" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2_d_inv" value="Value &amp;lt; 0, or a fill code 999 / 9999 / 99999?" style="rhombus;fillColor=#f4f1ea;strokeColor=#3f6212;strokeWidth=1.5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="1130" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2_rej1" value="&lt;b&gt;rejected += 1 · log the reason&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#fee2e2;strokeColor=#b91c1c;dashed=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="70.0" y="1165" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2_ts" value="&lt;b&gt;Parse the timestamp&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;Naive time → Asia/Kolkata (or the row's timezone) → convert to UTC; keep the original timezone name&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#44403c;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="340.0" y="1300" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2_d_st" value="Station known?&lt;br&gt;(city, external id, source)" style="rhombus;fillColor=#f4f1ea;strokeColor=#3f6212;strokeWidth=1.5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="1420" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2_d_ll" value="Latitude and longitude in the row?" style="rhombus;fillColor=#f4f1ea;strokeColor=#3f6212;strokeWidth=1.5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="920.0" y="1420" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2_rej2" value="&lt;b&gt;rejected += 1&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;Unknown station without coordinates&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#fee2e2;strokeColor=#b91c1c;dashed=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1300.0" y="1450" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2_create" value="&lt;b&gt;Create a MonitoringStation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;POINT(lon, lat) in EPSG:4326; created_from_csv = true&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#44403c;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="880.0" y="1630" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2_d_dup" value="Same station, pollutant, time and source already stored?" style="rhombus;fillColor=#f4f1ea;strokeColor=#3f6212;strokeWidth=1.5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1600" width="360" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2_skip2" value="&lt;b&gt;skipped += 1&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;A repeat import adds no second row&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#44403c;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="70.0" y="1630" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2_insert" value="&lt;b&gt;Insert the PollutionObservation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;Canonical and original unit, original timezone · quality_flag (default valid; sample for SAMPLE sources)&lt;br&gt;data_kind = observed · inserted += 1&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#44403c;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">

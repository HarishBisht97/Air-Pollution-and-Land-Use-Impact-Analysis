        <mxCell id="p4_foreach" value="&lt;b&gt;For each grid cell&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;Rasters, layers and stations are opened once&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#44403c;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="930.0" y="420" width="500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_idx" value="&lt;b&gt;Spectral indices (rasters masked to the cell)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;NDVI = (B8 − B4) / (B8 + B4) · NDBI = (B11 − B8) / (B11 + B8) · NDWI = (B3 − B8) / (B3 + B8)&lt;br&gt;Zero denominator → NaN · cell value = NaN-mean&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f7fee7;strokeColor=#3f6212;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="920.0" y="530" width="520" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p4_lc" value="&lt;b&gt;Land-cover shares&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;WorldCover code → study class: 10 tree · 20, 30 grass / sparse · 40 crop · 50 built · 60 bare · 80 water · else other&lt;br&gt;built %, vegetation % (tree + grass), water %; one LandCoverStatistic row per class and year&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f7fee7;strokeColor=#3f6212;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="920.0" y="660" width="520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4_rd" value="&lt;b&gt;Roads and industry (metres, UTM)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;road density = major-road length in the cell (km) / cell area (km²) · distance from the centroid to the nearest major road and industrial site&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f7fee7;strokeColor=#3f6212;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="920.0" y="800" width="520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p4_d_mon" value="A monitor inside the cell?" style="rhombus;fillColor=#f4f1ea;strokeColor=#3f6212;strokeWidth=1.5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1030.0" y="920" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p4_nullc" value="&lt;b&gt;Leave the cell unmeasured&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;mean = null, observation_count = 0. A null is not a low reading&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#fafaf9;strokeColor=#78716c;dashed=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1470.0" y="945" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4_assign" value="&lt;b&gt;Assign each monitor to one cell&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;The cell that covers the point; on a shared edge, the cell with the nearer centroid. Several monitors in one cell → hour-weighted mean&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#44403c;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="920.0" y="1080" width="520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p4_attach" value="&lt;b&gt;Attach mean and median PM2.5 and observation_count&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;data_kind = aggregated&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#44403c;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="920.0" y="1200" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4_d_n" value="≥ 8 monitored cells?&lt;br&gt;(hotspot_min_stations)" style="rhombus;fillColor=#f4f1ea;strokeColor=#3f6212;strokeWidth=1.5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1010.0" y="1300" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p4_refuse" value="&lt;b&gt;No pollution surface&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;Cells stay null; /hotspots returns refused&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#fee2e2;strokeColor=#b91c1c;dashed=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1470.0" y="1470" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4_idw" value="&lt;b&gt;A5 · IDW estimate for each cell with observation_count = 0&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;ẑ(x₀) = Σ wᵢ zᵢ / Σ wᵢ, wᵢ = 1 / dᵢ² (d in metres, UTM, from the cell centroid)&lt;br&gt;dᵢ &amp;lt; 1 m → zᵢ · pollution_assignment = idw_estimate · data_kind = statistical_estimate&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffedd5;strokeColor=#c2410c;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="920.0" y="1470" width="520" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p4_buff" value="&lt;b&gt;Buffer rings (on request)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;100, 300, 500, 1000 m in UTM · ring = buffer(d) − buffer(previous d) · a buffer describes a monitor's neighbourhood; it adds no samples&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#44403c;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="920.0" y="1640" width="520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p4_end" value="&lt;b&gt;End&lt;/b&gt;" style="rounded=1;arcSize=50;fillColor=#3f6212;strokeColor=#365314;fontColor=#ffffff;fontSize=13;strokeWidth=1.5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1030.0" y="1764" width="300" height="56" as="geometry" />
        </mxCell>

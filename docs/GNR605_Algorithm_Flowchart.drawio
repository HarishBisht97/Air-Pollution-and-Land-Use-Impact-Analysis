        <mxCell id="p8_q0" value="&lt;b&gt;A11b · Screening priority&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#e7e5e4&quot; style=&quot;font-size: 11px;&quot;&gt;POST /analysis/priority (optional weights)&lt;/font&gt;" style="rounded=1;arcSize=50;fillColor=#3f6212;strokeColor=#365314;fontColor=#ffffff;fontSize=13;strokeWidth=1.5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="540.0" y="990" width="340" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p8_q1" value="&lt;b&gt;Normalise&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;norm(v, lo, hi) = clamp((v − lo) / (hi − lo), 0, 1); null → 0&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f7fee7;strokeColor=#3f6212;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">

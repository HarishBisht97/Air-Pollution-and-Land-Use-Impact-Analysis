        <mxCell id="p0_hourly" value="&lt;b&gt;A3 · Build the CPCB hourly AQI extract&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;Workbooks → hourly .csv.gz → daily (≥ 16 h) → monthly JSON&lt;/font&gt;" style="shape=process;backgroundOutline=1;size=0.035;fillColor=#ecfccb;strokeColor=#3f6212;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1070.0" y="610" width="380" height="80" as="geometry" />

        <mxCell id="p7_r2" value="&lt;b&gt;OLS with a built-up control&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;pollutant = β₀ + β₁·distance + β₂·built % · β₁ × 1000 = change per km&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f7fee7;strokeColor=#3f6212;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="740.0" y="1190" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p7_r3" value="&lt;b&gt;Reading rule (ρ &amp;lt; 0: higher nearer the road)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;Both |ρ| &amp;lt; 0.2 → unclear&lt;br&gt;NO2 ρ &amp;lt; 0 and clearly stronger than PM2.5 (by &amp;gt; 0.1 when both are negative) → NO2 stronger&lt;br&gt;Both ρ &amp;lt; 0 otherwise → both together&lt;br&gt;Else → unclear&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f7fee7;strokeColor=#3f6212;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="740.0" y="1330" width="280" height="200" as="geometry" />
        </mxCell>

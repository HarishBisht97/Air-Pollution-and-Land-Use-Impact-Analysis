        <mxCell id="p8_q2" value="observation_count &amp;gt; 0?" style="rhombus;fillColor=#f4f1ea;strokeColor=#3f6212;strokeWidth=1.5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="580.0" y="1194" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p8_q3" value="&lt;b&gt;severity = norm(mean, 0, 150)&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#f7fee7;strokeColor=#3f6212;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="540.0" y="1344" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p8_q4" value="&lt;b&gt;Other components&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;built = norm(built %, 0, 100) · roads = norm(density, 0, 20)&lt;br&gt;vegetation deficit = 1 − norm(veg %, 0, 100)&lt;br&gt;confidence = min(1, obs / 30)&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f7fee7;strokeColor=#3f6212;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="540.0" y="1434" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p8_q5" value="&lt;b&gt;Score over the known components&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;score = Σ wᵢ cᵢ / Σ wᵢ (null components skipped)&lt;br&gt;severity 0.35 · built 0.20 · roads 0.15 · vegetation deficit 0.15 · confidence 0.15&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f7fee7;strokeColor=#3f6212;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">

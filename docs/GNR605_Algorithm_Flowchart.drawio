        <mxCell id="p6_bfit" value="&lt;b&gt;Built-area line&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;OLS built_km² = a + b·year over every mapped year&lt;br&gt;Predict 2026, 2027, 2028 with the 95% mean confidence interval&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f7fee7;strokeColor=#3f6212;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">

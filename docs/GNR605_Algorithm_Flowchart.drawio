        <mxCell id="p0_grid" value="&lt;b&gt;A4 · Grid metrics and station-in-cell assignment&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;NDVI, NDBI, land-cover %, road density and distances per 1 km cell; pollution only where a monitor sits&lt;/font&gt;" style="shape=process;backgroundOutline=1;size=0.035;fillColor=#ecfccb;strokeColor=#3f6212;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="480.0" y="890" width="560" height="80" as="geometry" />

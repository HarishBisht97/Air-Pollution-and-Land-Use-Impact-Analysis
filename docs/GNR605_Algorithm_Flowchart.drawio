        <mxCell id="p0_sample" value="&lt;b&gt;Sample path&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;Synthetic monthly series at 12 CAAQMS coordinates: base × month factor × year trend × station factor. Labeled SAMPLE.&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#fef3c7;strokeColor=#a16207;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="90.0" y="452" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p0_research" value="&lt;b&gt;Research path&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;XKDR daily / monthly CPCB concentrations · CPCB hourly AQI workbooks 2025–26 · Dynamic World label rasters 2018–2026 · OSM Overpass · station classes and wards&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;fillColor=#e0f2fe;strokeColor=#0369a1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1070.0" y="442" width="380" height="110" as="geometry" />
        </mxCell>

        </mxCell>
        <mxCell id="p4_start" value="&lt;b&gt;Start · A4&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#e7e5e4&quot; style=&quot;font-size: 11px;&quot;&gt;City boundary (EPSG:4326), resolution r = 1000 m&lt;/font&gt;" style="rounded=1;arcSize=50;fillColor=#3f6212;strokeColor=#365314;fontColor=#ffffff;fontSize=13;strokeWidth=1.5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="240.0" y="100" width="440" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p4_proj" value="&lt;b&gt;Project the boundary to EPSG:32643&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;(minx, miny, maxx, maxy) = projected bounds&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#44403c;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="240.0" y="200" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_inity" value="&lt;b&gt;y ← miny, row ← 0&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#44403c;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="240.0" y="306" width="440" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4_d_y" value="y &amp;lt; maxy?" style="rhombus;fillColor=#f4f1ea;strokeColor=#3f6212;strokeWidth=1.5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="320.0" y="400" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4_initx" value="&lt;b&gt;x ← minx, col ← 0&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#44403c;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="240.0" y="550" width="440" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4_d_x" value="x &amp;lt; maxx?" style="rhombus;fillColor=#f4f1ea;strokeColor=#3f6212;strokeWidth=1.5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="320.0" y="640" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4_incy" value="&lt;b&gt;y ← y + r&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;row ← row + 1&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#44403c;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="20.0" y="665" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4_cell" value="&lt;b&gt;Square cell (x, y, x + r, y + r)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;clipped = cell ∩ projected boundary&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#44403c;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="240.0" y="790" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_d_area" value="clipped area &amp;gt; 0?" style="rhombus;fillColor=#f4f1ea;strokeColor=#3f6212;strokeWidth=1.5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="320.0" y="900" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4_store" value="&lt;b&gt;Store cell R{row:03}C{col:03}&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;Geometry back to EPSG:4326 · area_sq_km from the projected polygon&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#44403c;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">

        <mxCell id="p8_l2" value="&lt;b&gt;For each class&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;Δ km² = recent − baseline&lt;br&gt;Δ pp = 100·recent / Σ recent − 100·baseline / Σ baseline&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f7fee7;strokeColor=#3f6212;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="80.0" y="1194" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p8_l3" value="&lt;b&gt;Comparability flag&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;comparable_classification_scheme = same algorithm in both years (WorldCover 2020 v100 vs 2021 v200 → false, with a caveat)&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f7fee7;strokeColor=#3f6212;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="80.0" y="1334" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p8_l4" value="&lt;b&gt;Return classes, flag and caveat&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;data_kind = classified&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;fillColor=#e0f2fe;strokeColor=#0369a1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">

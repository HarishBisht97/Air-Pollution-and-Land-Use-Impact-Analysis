        <mxCell id="p4_subtitle" value="backend/app/geospatial/grid.py, idw.py, buffers.py · backend/app/workers/seed.py · backend/app/ingestion/grid_cpcb.py" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;fontSize=13;fontColor=#57534e;" vertex="1" parent="1">

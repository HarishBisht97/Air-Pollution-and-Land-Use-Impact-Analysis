        <mxCell id="p5_ld" value="&lt;b&gt;Load XKDR daily concentrations&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;PM2.5, PM10, NO2, SO2, NH3 · keep station-days with n ≥ 16 hourly values&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;fillColor=#e0f2fe;strokeColor=#0369a1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">

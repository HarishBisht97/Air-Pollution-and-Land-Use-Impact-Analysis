        <mxCell id="p0_subtitle" value="End-to-end flow. Each green double-edged box is a sub-algorithm with its own page (A2–A11)." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;fontSize=13;fontColor=#57534e;" vertex="1" parent="1">

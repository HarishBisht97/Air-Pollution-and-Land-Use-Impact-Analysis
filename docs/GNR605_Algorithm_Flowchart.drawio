        <mxCell id="p5_sub" value="&lt;b&gt;Sub-index for each pollutant&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#44403c&quot; style=&quot;font-size: 11px;&quot;&gt;I = I_lo + (C − C_lo) × (I_hi − I_lo) / (C_hi − C_lo)&lt;br&gt;C &amp;lt; 0 → 0 · C above the top breakpoint → 500&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f7fee7;strokeColor=#3f6212;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1c1917;align=center;verticalAlign=middle;strokeWidth=1.25;spacing=6;" vertex="1" parent="1">

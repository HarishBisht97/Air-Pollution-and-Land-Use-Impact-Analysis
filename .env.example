# Application
APP_NAME=Air Pollution and Land Use Impact Analysis
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Database (PostGIS)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=air_land_use
POSTGRES_USER=gis
POSTGRES_PASSWORD=gis
DATABASE_URL=postgresql+psycopg://gis:gis@db:5432/air_land_use

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Study area
DEFAULT_CITY_SLUG=delhi
CITY_CONFIG_DIR=config/cities
GRID_RESOLUTION_M=1000

# Data directories
DATA_DIR=data
RAW_DATA_DIR=data/raw
INTERIM_DATA_DIR=data/interim
PROCESSED_DATA_DIR=data/processed
SAMPLE_DATA_DIR=data/sample

# Query / export limits
MAX_DATE_RANGE_DAYS=10000
MAX_PAGE_LIMIT=1000
DEFAULT_PAGE_LIMIT=100
MAX_EXPORT_ROWS=50000

# Background jobs
JOB_POLL_INTERVAL_SECONDS=2

# Optional: OpenAQ (leave empty to skip live import)
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v3

# Optional: Copernicus Data Space / Sentinel Hub
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1

# Optional: Google Earth Engine service account JSON path
GEE_SERVICE_ACCOUNT=
GEE_PROJECT=

# Optional: Overpass for OSM extracts
OVERPASS_URL=https://overpass-api.de/api/interpreter
